DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ai_support

LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RETRIEVAL_MIN_SIMILARITY=0.25
RETRIEVAL_LIMIT=3

DEBUG=false

# JSON array of explicitly allowed frontend origins.
# Keep empty when the API is used without a browser frontend.
CORS_ORIGINS=[]
