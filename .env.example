DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ai_support

LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RETRIEVAL_MIN_SIMILARITY=0.25
RETRIEVAL_LIMIT=3

AUTH_MODE=jwt
JWT_ALGORITHM=HS256
JWT_SECRET=local-development-secret-change-before-deploy
JWT_JWKS_URL=
JWT_ISSUER=ai-support-platform
JWT_AUDIENCE=ai-support-api
JWT_LEEWAY_SECONDS=10

REDIS_URL=redis://redis:6379/0
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

DEBUG=false

# JSON array of explicitly allowed frontend origins.
# Keep empty when the API is used without a browser frontend.
CORS_ORIGINS=[]
